# Copy to .env / apps/web/.env.local — never commit real secrets.

# --- Model provider (server-only) ---
MODEL_PROVIDER=nrp
NRP_BASE_URL=
NRP_API_KEY=
NRP_MODEL=gpt-oss
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Storage backend ---
# local  = JSON files under ./data (default for teammate onboarding, no cloud required)
# supabase = Postgres + Storage (production path; needs service role on server)
STORAGE_BACKEND=local
DEMO_OWNER_ID=00000000-0000-4000-8000-000000000001

# --- Supabase (required only when STORAGE_BACKEND=supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Upload limits ---
MAX_UPLOAD_BYTES=5242880
